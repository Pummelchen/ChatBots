.DS_Store
.build/
.swiftpm/
*.xcodeproj
dist/

# Downloaded checkpoints (multi-GB local data, never committed)
models/

# Installer output. These are logs and caches rather than sources, and they contain
# machine-specific paths.
#
# One pattern rather than a list of names: the installer writes four logs today
# (`.install.log`, `-build`, `-check`, `-transport`) and the last of them was missing here,
# so `git status` was never clean after running the installer. A new log should not have to
# be remembered in two places.
.install*.log
models/.huggingface-file-list.txt
models/.hf-model.json

# Runtime state from tools/start.sh (pid files and logs)
.run/

# Device captures from tools/capture-devices.py (regenerate rather than commit)
captures/

# Local API keys. Never committed, by design: a key in a repository is a public key.
.secrets.env

# The wiki, checked out beside the code so the two are edited together. It is its own
# repository (ChatBots.wiki.git) and is pushed there; without this line git would record it
# here as a submodule-like gitlink and the pages would be committed to the wrong repository.
ChatBots.wiki/

# An interrupted ledger write leaves this behind. It was committed once by accident (A19);
# the ledger is only ever the file without the suffix.
AUDIT/*.tmp
