.DS_Store
.build/
.swiftpm/
*.xcodeproj
dist/

# Downloaded checkpoints (multi-GB local data, never committed).
#
# Anchored to the repository root with a leading `/`. Unanchored, `models/` also matched
# `Sources/ChatBotsCore/Models/` on a case-insensitive filesystem (the macOS default,
# `core.ignorecase=true`), so a *new* source file added to the Models directory was
# silently ignored by `git add` — the tracked files were unaffected, which is what made
# it invisible until `git add` on a new one failed or skipped.
/models/

# Installer output. These are logs and caches rather than sources, and they contain
# machine-specific paths.
#
# One pattern rather than a list of names: the installer writes four logs today
# (`.install.log`, `-build`, `-check`, `-transport`) and the last of them was missing here,
# so `git status` was never clean after running the installer. A new log should not have to
# be remembered in two places.
.install*.log
/models/.huggingface-file-list.txt
/models/.hf-model.json

# Runtime state from tools/start.sh (pid files and logs)
.run/

# Device captures from tools/capture-devices.py (regenerate rather than commit)
captures/

# Local API keys. Never committed, by design: a key in a repository is a public key.
.secrets.env

# The wiki, checked out beside the code so the two are edited together. It is its own
# repository (ChatBots.wiki.git) and is pushed there; without this line git would record it
# here as a submodule-like gitlink and the pages would be committed to the wrong repository.
ChatBots.wiki/

# Python bytecode. The `static-analysis` CI job runs `python3 -m py_compile` over every helper
# script, and running any of them locally leaves the same thing behind. A tree that is dirty for the
# wrong reason is a tree nobody reads, and every gate that reads `git status` depends on it meaning
# something.
__pycache__/
*.py[cod]

# `swift test --enable-code-coverage` makes every product in that build instrumented, so running one
# by hand — `chatbots-cli --check --model-a …`, which is how a checkpoint is verified — writes this
# profile into the working directory. It is build output, not evidence: the coverage this repository
# keeps is the report `tools/mac-checks.sh` produces.
*.profraw
