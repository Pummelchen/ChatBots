# A181 — an option given without a value (2026-09-15T15:17:25Z)

## 1. before: the loop re-read the same argument for ever
$ git show HEAD:tools/start.sh | grep -n 'shift 2' | head -4
  59:    --port) PORT="${2:-}"; shift 2 ;;
  60:    --engine) ENGINE_PORT="${2:-}"; shift 2 ;;
  62:    --open) OPEN_WHERE="${2:-none}"; shift 2 ;;
  63:    --view) VIEW_MODE="${2:-auto}"; shift 2 ;;
$ timeout 3 bash tools/start.sh --port
  exit=124 (124 is the timeout: it never printed anything and never exited)
  output: 0 bytes

## 2. after: every value-taking option says what it needs
$ grep -n 'require_value' tools/start.sh tools/start-app.sh | head -8
  tools/start.sh:63:require_value() {
  tools/start.sh:74:      require_value "$1" "${2:-}"
  tools/start.sh:77:      require_value "$1" "${2:-}"
  tools/start.sh:81:      require_value "$1" "${2:-}"
  tools/start.sh:84:      require_value "$1" "${2:-}"
  tools/start-app.sh:39:require_value() {
  tools/start-app.sh:51:      require_value "$1" "${2:-}"

  bash tools/start.sh --port    exit=2  --port needs a value
  bash tools/start.sh --engine  exit=2  --engine needs a value
  bash tools/start.sh --open    exit=2  --open needs a value
  bash tools/start.sh --view    exit=2  --view needs a value
  bash tools/start-app.sh --port exit=2  --port needs a value

## 3. the counterweight: valid usage is untouched
  --port 7999 --unknown   exit=2  unknown option: --unknown
  --port 7999 --status    exit=0  ==> ChatBots web service

$ shellcheck tools/start.sh tools/start-app.sh
